  <div class="overlay-card">
    <h2 id="pauseTitle">Paused</h2>
    <p>Take a breath. The clock is stopped.</p>
    <button class="btn-accent" id="resumeBtn">Resume</button>
    <button class="btn-ghost" id="endRoundBtn">End round</button>
  </div>
</div>

<script>
/* ==================================================================
   SUPABASE CONFIG
   👉 These are your project's values (Project Settings → API).
   The publishable key is safe to ship in client code — data access
   is controlled by Row Level Security policies on the table.
   ================================================================== */
const SUPABASE_URL = "https://zciulgqkqusjxomyapcz.supabase.co";
const SUPABASE_KEY = "sb_publishable_t3LKmsyqW22dT4ZMlKWQkg_UIyTziIe";
const TABLE = "arcade_sessions"; // existing table in this project

const sb = SUPABASE_URL.startsWith("http")
  ? supabase.createClient(SUPABASE_URL, SUPABASE_KEY)
  : null;

/* ==================================================================
   SMALL HELPERS + PERSISTENCE
   ================================================================== */
const $ = (id) => document.getElementById(id);
const randInt = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;
const pick = (arr) => arr[randInt(0, arr.length - 1)];
const shuffle = (arr) => { const a = [...arr]; for (let i = a.length - 1; i > 0; i--) { const j = randInt(0, i); [a[i], a[j]] = [a[j], a[i]]; } return a; };
const todayKey = () => new Date().toISOString().slice(0, 10);
const store = {
  get(k, fb) { try { const v = localStorage.getItem(k); return v === null ? fb : JSON.parse(v); } catch { return fb; } },
  set(k, v) { localStorage.setItem(k, JSON.stringify(v)); },
};
function announce(msg) { $("liveRegion").textContent = msg; }

// Stable anonymous device id so your sessions group together in the DB.
let deviceId = store.get("mfa-device-id", null);
if (!deviceId) { deviceId = crypto.randomUUID(); store.set("mfa-device-id", deviceId); }