    $(falseId).classList.add("flash-wrong");
  } else {
    $(falseId).classList.add("flash-correct");
    $(trueId).classList.add("flash-wrong");
  }
  [trueId, falseId, "tfTrue" + (playerIdx === 0 ? "Bottom" : "Top"), "tfFalse" + (playerIdx === 0 ? "Bottom" : "Top")].forEach(id => $(id).disabled = true);
  tf.round++;
  mpTimeout(tfNext, 900);
}

$("tfTrueTop").addEventListener("click", () => tfAnswer(0, true));
$("tfFalseTop").addEventListener("click", () => tfAnswer(0, false));
$("tfTrueBottom").addEventListener("click", () => tfAnswer(1, true));
$("tfFalseBottom").addEventListener("click", () => tfAnswer(1, false));

const tfBack = document.createElement("button");
tfBack.style.cssText = "position:absolute;top:10px;right:10px;z-index:10;width:40px;height:40px;border-radius:12px;background:var(--card);border:1px solid var(--border);font-size:17px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--text);";
tfBack.textContent = "←";
tfBack.addEventListener("click", quitMpGame);
$("screen-f2f-truefalse").appendChild(tfBack);

/* ==================================================================
   F2F 4 — NUMBER TUG-OF-WAR
   ================================================================== */
let tug = {};
const TUG_STEPS = 10; // each player has a 0–10 "position", starts at 5

function startF2FTug() {
  tug = { pos: 5, locked: false, current: null };
  const [p1, p2] = mp.players;
  $("tugNameTop").textContent = p1;
  $("tugNameBottom").textContent = p2;
  $("tugLabelLeft").textContent = p1;
  $("tugLabelRight").textContent = p2;
  updateTugRope();
  showF2FScreen("screen-f2f-tug");
  tugNext();
}

function updateTugRope() {
  const pct = (tug.pos / TUG_STEPS) * 100;
  $("tugFill").style.width = pct + "%";
  $("tugKnot").style.left = pct + "%";
  $("tugScoreNumTop").textContent = tug.pos;    // P1's pull (how far knot is toward them)
  $("tugScoreNumBottom").textContent = TUG_STEPS - tug.pos;
}

function tugNext() {
  tug.current = genMpProblem(Math.abs(tug.pos - 5));
  tug.locked = false;
  $("tugQuestion").innerHTML = exprHTML(tug.current.parts);
  const opts = shuffle([tug.current.answer, ...makeDistractors(tug.current.answer)]);

  function makeButtons(id, playerIdx) {
    const wrap = $(id);
    wrap.innerHTML = "";
    for (const opt of opts) {
      const btn = document.createElement("button");
      btn.className = "f2f-answer-btn";
      btn.textContent = opt;
      btn.addEventListener("click", () => {
        if (tug.locked) return;
        tug.locked = true;
        if (opt === tug.current.answer) {
          btn.classList.add("correct");
          tug.pos = Math.max(0, Math.min(TUG_STEPS, tug.pos + (playerIdx === 0 ? 1 : -1)));
          mp.scores[playerIdx] = (mp.scores[playerIdx] || 0) + 1;
          updateTugRope();
          if (tug.pos <= 0 || tug.pos >= TUG_STEPS) {
            const winner = tug.pos >= TUG_STEPS ? 0 : 1;
            mpTimeout(() => showMpResults(`${mp.players[winner]} Wins! 🎉`, "They pulled the rope all the way!", "🔢"), 700);
            return;
          }
        } else {
          btn.classList.add("wrong");
        }
        mpTimeout(tugNext, 600);
      });
      wrap.appendChild(btn);
    }
  }
  makeButtons("tugAnswersTop", 0);
  makeButtons("tugAnswersBottom", 1);
}

const tugBack = document.createElement("button");
tugBack.style.cssText = "position:absolute;top:10px;right:10px;z-index:10;width:40px;height:40px;border-radius:12px;background:var(--card);border:1px solid var(--border);font-size:17px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--text);";
tugBack.textContent = "←";
tugBack.addEventListener("click", quitMpGame);
$("screen-f2f-tug").appendChild(tugBack);

/* ==================================================================
   PASS-AND-PLAY SHARED HELPERS
   ================================================================== */
let mpRound = {}; // shared state for current player's turn in pass-and-play

function nextMpPlayer(afterIdx, callback) {
  const next = (afterIdx + 1) % mp.players.length;
  mp.currentIdx = next;
  showPassScreen(next, callback);
}

/* ==================================================================
   MP 5 — MATH TOURNAMENT (pass-and-play, 2-4 players)
   ================================================================== */
let tourn = {};
const TOURN_TIME = 60;

$("tournQuit").addEventListener("click", () => { clearMpTimers(); showTab("home"); document.body.classList.remove("in-game"); });
$("tournPause").addEventListener("click", () => {
  if (tourn.paused) {
    tourn.paused = false;
    tournTick();
  } else {
    tourn.paused = true;
    clearMpTimers();
  }
});

function startMpTournament() {
  mp.scores = mp.players.map(() => 0);
  mp.currentIdx = 0;
  showPassScreen(0, () => tournBeginPlayerTurn(0));
}

function tournBeginPlayerTurn(idx) {
  tourn = { idx, timeLeft: TOURN_TIME, score: 0, solved: 0, locked: false, paused: false, current: null };
  renderPlayerHud($("tournPlayerHud"), idx);
  $("tournTitle").textContent = mp.players[idx] + "'s Turn";
  showScreen("screen-mp-tournament");
  $("tournScore").textContent = 0;
  $("tournSolved").textContent = 0;
  $("tournFeedback").className = "feedback";
  tournUpdateTimer();
  tournNext();
  tournTick();
}

function tournTick() {
  if (tourn.paused) return;
  const t = mpTimeout(() => {
    tourn.timeLeft--;
    tournUpdateTimer();
    if (tourn.timeLeft <= 0) {
      mp.scores[tourn.idx] = tourn.score;
      const next = tourn.idx + 1;
      if (next >= mp.players.length) {
        showMpResults("Tournament Results! 🏆", "Here's the final leaderboard", "🏆");
      } else {
        showPassScreen(next, () => tournBeginPlayerTurn(next));
      }
    } else {
      tournTick();
    }
  }, 1000);
}

function tournUpdateTimer() {
  const m = Math.floor(tourn.timeLeft / 60), s = tourn.timeLeft % 60;
  $("tournTime").textContent = `${m}:${String(s).padStart(2,"0")}`;
  $("tournTimebar").style.width = (tourn.timeLeft / TOURN_TIME * 100) + "%";
  $("screen-mp-tournament").querySelector(".hud").classList.toggle("low", tourn.timeLeft <= 10);
}

function tournNext() {
  tourn.current = genMpProblem(tourn.solved);
  tourn.locked = false;
  $("tournExpr").innerHTML = exprHTML(tourn.current.parts);
  const opts = shuffle([tourn.current.answer, ...makeDistractors(tourn.current.answer)]);
  const wrap = $("tournChoices");
  wrap.innerHTML = "";
  for (const opt of opts) {
    const btn = document.createElement("button");
    btn.className = "choice";
    btn.textContent = opt;
    btn.addEventListener("click", () => {
      if (tourn.locked || tourn.timeLeft <= 0) return;
      tourn.locked = true;
      const fb = $("tournFeedback");
      if (opt === tourn.current.answer) {
        const pts = 10 * (tourn.solved + 1);
        tourn.score += pts; tourn.solved++;
        $("tournScore").textContent = tourn.score;
        $("tournSolved").textContent = tourn.solved;
        btn.classList.add("good");
        fb.className = "feedback good show";
        $("tournFbText").textContent = "✓ Correct!";
        $("tournFbPts").textContent = "+" + pts;
      } else {
        btn.classList.add("bad");
        wrap.querySelectorAll(".choice").forEach(b => { if (+b.textContent === tourn.current.answer) b.classList.add("good"); });
        fb.className = "feedback bad show";
        $("tournFbText").textContent = "✗ Not quite";
        $("tournFbPts").textContent = "= " + tourn.current.answer;
      }
      mpTimeout(() => { if (tourn.timeLeft > 0) tournNext(); }, 480);
    });
    wrap.appendChild(btn);
  }
}

/* ==================================================================
   MP 6 — HOT POTATO MATH
   ================================================================== */
let potato = {};
const POTATO_TIME = 8;

$("potatoQuit").addEventListener("click", () => { clearMpTimers(); showTab("home"); document.body.classList.remove("in-game"); });

function startMpPotato() {
  mp.scores = mp.players.map(() => 0);
  mp.lives = mp.players.map(() => 3);
  mp.currentIdx = 0;
  potatoBeginTurn(0);
}

function potatoBeginTurn(idx) {
  clearMpTimers();
  potato = { idx, timeLeft: POTATO_TIME, current: null, locked: false };
  renderPlayerHud($("potatoPlayerHud"), idx);
  showScreen("screen-mp-potato");
  potatoNext();
  potatoTick();
}

function potatoTick() {
  const t = mpTimeout(() => {
    potato.timeLeft--;
    $("potatoTimerBig").textContent = potato.timeLeft;
    $("potatoTimerBig").classList.toggle("urgent", potato.timeLeft <= 3);
    if (potato.timeLeft <= 0) {
      mp.lives[potato.idx] = Math.max(0, mp.lives[potato.idx] - 1);
      const activePlayers = mp.players.filter((_, i) => mp.lives[i] > 0);
      if (activePlayers.length <= 1) {
        mp.scores = mp.lives.map((l, i) => l * 10 + mp.scores[i]);
        showMpResults("Hot Potato Results! 🥔", "Most lives remaining wins", "🥔");
        return;
      }
      let next = (potato.idx + 1) % mp.players.length;
      while (mp.lives[next] <= 0) next = (next + 1) % mp.players.length;
      mpTimeout(() => potatoBeginTurn(next), 400);
    } else {
      potatoTick();
    }
  }, 1000);
}

function potatoNext() {
  potato.current = genMpProblem(mp.scores[potato.idx]);
  potato.locked = false;
  potato.timeLeft = POTATO_TIME;
  $("potatoTimerBig").textContent = POTATO_TIME;
  $("potatoTimerBig").classList.remove("urgent");
  $("potatoExpr").innerHTML = exprHTML(potato.current.parts);

  const opts = shuffle([potato.current.answer, ...makeDistractors(potato.current.answer)]);
  const wrap = $("potatoChoices");
  wrap.innerHTML = "";
  for (const opt of opts) {
    const btn = document.createElement("button");
    btn.className = "choice";
    btn.textContent = opt;
    btn.addEventListener("click", () => {
      if (potato.locked || potato.timeLeft <= 0) return;
      potato.locked = true;
      clearMpTimers();
      if (opt === potato.current.answer) {
        btn.classList.add("good");
        mp.scores[potato.idx]++;
        let next = (potato.idx + 1) % mp.players.length;
        while (mp.lives[next] <= 0) next = (next + 1) % mp.players.length;
        mpTimeout(() => potatoBeginTurn(next), 500);
      } else {
        clearMpTimers();
        btn.classList.add("bad");
        mp.lives[potato.idx] = Math.max(0, mp.lives[potato.idx] - 1);
        const activePlayers = mp.players.filter((_, i) => mp.lives[i] > 0);
        if (activePlayers.length <= 1) {
          mp.scores = mp.lives.map((l, i) => l * 10 + mp.scores[i]);
          mpTimeout(() => showMpResults("Hot Potato Results! 🥔", "Last one standing!", "🥔"), 500);
          return;
        }
        mpTimeout(() => { potatoNext(); potatoTick(); }, 700);
      }
    });
    wrap.appendChild(btn);
  }
}

/* ==================================================================
   MP 7 — LIGHTNING BLITZ
   ================================================================== */
let blitz = {};
const BLITZ_TIME = 30;

$("blitzQuit").addEventListener("click", () => { clearMpTimers(); showTab("home"); document.body.classList.remove("in-game"); });
$("blitzPause").addEventListener("click", () => {
  if (blitz.paused) { blitz.paused = false; blitzTick(); }
  else { blitz.paused = true; clearMpTimers(); }
});

function startMpBlitz() {
  mp.scores = mp.players.map(() => 0);
  mp.currentIdx = 0;
  showPassScreen(0, () => blitzBeginTurn(0));
}

function blitzBeginTurn(idx) {
  blitz = { idx, timeLeft: BLITZ_TIME, hit: 0, miss: 0, locked: false, paused: false, current: null };
  renderPlayerHud($("blitzPlayerHud"), idx);
  $("blitzTime").textContent = `0:${BLITZ_TIME}`;
  $("blitzHit").textContent = 0;
  $("blitzMiss").textContent = 0;
  $("blitzFeedback").className = "feedback";
  showScreen("screen-mp-blitz");
  blitzNext();
  blitzTick();
}

function blitzTick() {
  if (blitz.paused) return;
  mpTimeout(() => {
    blitz.timeLeft--;
    const s = blitz.timeLeft % 60;
    $("blitzTime").textContent = `0:${String(s).padStart(2,"0")}`;
    $("blitzTimebar").style.width = (blitz.timeLeft / BLITZ_TIME * 100) + "%";
    if (blitz.timeLeft <= 0) {
      mp.scores[blitz.idx] = blitz.hit;
      const next = blitz.idx + 1;
      if (next >= mp.players.length) {
        showMpResults("Lightning Blitz Results! ⚡", "Most correct answers in 30s wins", "⚡");
      } else {
        showPassScreen(next, () => blitzBeginTurn(next));
      }
    } else {
      blitzTick();
    }
  }, 1000);
}

function blitzNext() {
  blitz.current = twoOp(pick(["add","sub","mul"]), 2, 20);
  blitz.locked = false;
  $("blitzExpr").innerHTML = exprHTML(blitz.current.parts);
  const opts = shuffle([blitz.current.answer, ...makeDistractors(blitz.current.answer)]);
  const wrap = $("blitzChoices");
  wrap.innerHTML = "";
  for (const opt of opts) {
    const btn = document.createElement("button");
    btn.className = "choice";
    btn.textContent = opt;
    btn.addEventListener("click", () => {
      if (blitz.locked || blitz.timeLeft <= 0) return;
      blitz.locked = true;
      const fb = $("blitzFeedback");
      if (opt === blitz.current.answer) {
        blitz.hit++;
        $("blitzHit").textContent = blitz.hit;
        btn.classList.add("good");
        fb.className = "feedback good show";
        $("blitzFbText").textContent = "✓ Correct!";
      } else {
        blitz.miss++;
        $("blitzMiss").textContent = blitz.miss;
        btn.classList.add("bad");
        fb.className = "feedback bad show";
        $("blitzFbText").textContent = "✗ Not quite";
      }
      mpTimeout(blitzNext, 400);
    });
    wrap.appendChild(btn);
  }
}

/* ==================================================================
   MP 8 — NUMBER WAR
   ================================================================== */
let war = {};
const WAR_ROUNDS = 8;

$("warQuit").addEventListener("click", () => { clearMpTimers(); showTab("home"); document.body.classList.remove("in-game"); });

function startMpWar() {
  mp.scores = mp.players.map(() => 0);
  mp.currentIdx = 0;
  war = { round: 0 };
  showPassScreen(0, () => warBeginTurn(0));
}

function warBeginTurn(idx) {
  war.idx = idx;
  war.locked = false;
  renderPlayerHud($("warPlayerHud"), idx);
  showScreen("screen-mp-war");

  // Deal two random "cards" (values 1-13)
  war.cardA = randInt(1, 13);
  war.cardB = randInt(1, 13);
  war.cardLabels = ["♠ " + war.cardA, "♥ " + war.cardB];
  war.higher = Math.max(war.cardA, war.cardB);
  war.lower = Math.min(war.cardA, war.cardB);

  // Generate a math problem whose answer is the higher card
  const prob = { parts: [war.higher], answer: war.higher };
  if (war.higher > war.lower && war.lower > 0) {
    prob.parts = [war.higher + war.lower, "−", war.lower];
    prob.answer = war.higher;
  } else {
    prob.parts = [war.higher - 1, "+", 1];
    prob.answer = war.higher;
  }
  war.prob = prob;

  $("warKicker").textContent = `Round ${war.round + 1} / ${WAR_ROUNDS} — ${mp.players[idx]}'s turn`;
  $("warExpr").innerHTML = exprHTML(prob.parts);
  $("warCards").innerHTML = `
    <div class="stat-card" style="text-align:center;font-size:22px;font-weight:700;">${war.cardLabels[0]}</div>
    <div class="stat-card" style="text-align:center;font-size:22px;font-weight:700;">${war.cardLabels[1]}</div>`;

  const opts = shuffle([war.higher, ...makeDistractors(war.higher)]);
  const wrap = $("warChoices");
  wrap.innerHTML = "";
  $("warFeedback").className = "feedback";
  for (const opt of opts) {
    const btn = document.createElement("button");
    btn.className = "choice";
    btn.textContent = opt;
    btn.addEventListener("click", () => {
      if (war.locked) return;
      war.locked = true;
      const fb = $("warFeedback");
      if (opt === war.higher) {
        mp.scores[idx]++;
        btn.classList.add("good");
        fb.className = "feedback good show";
        $("warFbText").textContent = `✓ Correct! ${mp.players[idx]} wins the card!`;
      } else {
        btn.classList.add("bad");
        wrap.querySelectorAll(".choice").forEach(b => { if (+b.textContent === war.higher) b.classList.add("good"); });
        fb.className = "feedback bad show";
        $("warFbText").textContent = `✗ It was ${war.higher}`;
      }
      war.round++;
      mpTimeout(() => {
        const next = (idx + 1) % mp.players.length;
        if (war.round >= WAR_ROUNDS) {
          showMpResults("Number War Results! 🃏", "Most cards claimed wins", "🃏");
        } else {
          showPassScreen(next, () => warBeginTurn(next));
        }
      }, 700);
    });
    wrap.appendChild(btn);
  }
}

/* ==================================================================
   MP 9 — MEMORY MASTERS (shared board, take turns)
   ================================================================== */
let mm = {};
const MM_EMOJI = ["🍕","🌈","🦊","🎸","🏆","🚂","🐬","💎"];

$("mmQuit").addEventListener("click", () => { clearMpTimers(); showTab("home"); document.body.classList.remove("in-game"); });

function startMpMemory() {
  mp.scores = mp.players.map(() => 0);
  mp.currentIdx = 0;
  mm = { cards: [], open: [], lock: false, round: 0, totalPairs: 8 };
  mmBuildBoard();
  showScreen("screen-mp-memory");
  mmUpdateHUD();
}

function mmBuildBoard() {
  mm.cards = shuffle([...MM_EMOJI, ...MM_EMOJI]).map(v => ({ v, done: false }));
  mm.open = [];
  mm.pairsLeft = 8;
  const grid = $("mmGrid");
  grid.innerHTML = "";
  mm.cards.forEach((card, i) => {
    const btn = document.createElement("button");
    btn.className = "mem-card";
    btn.textContent = "?";
    btn.addEventListener("click", () => mmFlip(i, btn));
    grid.appendChild(btn);
  });
}

function mmUpdateHUD() {
  $("mmPairsLeft").textContent = mm.pairsLeft;
  $("mmTurnName").textContent = mp.players[mp.currentIdx];
  $("mmRound").textContent = mm.round + 1;
  $("mmTurnName").style.color = PLAYER_COLORS[mp.currentIdx];
}

function mmFlip(i, btn) {
  if (mm.lock || btn.classList.contains("done") || mm.open.some(o => o.i === i)) return;
  const card = mm.cards[i];
  if (card.done) return;
  btn.textContent = card.v;
  btn.classList.add("open");
  mm.open.push({ i, btn });
  if (mm.open.length < 2) return;

  const [a, b] = mm.open;
  mm.open = [];
  mm.lock = true;

  if (mm.cards[a.i].v === mm.cards[b.i].v) {
    mm.cards[a.i].done = mm.cards[b.i].done = true;
    [a.btn, b.btn].forEach(el => { el.classList.remove("open"); el.classList.add("done"); });
    mp.scores[mp.currentIdx]++;
    mm.pairsLeft--;
    mm.lock = false;
    mmUpdateHUD();
    announce(`${mp.players[mp.currentIdx]} matched a pair!`);
    if (mm.pairsLeft <= 0) {
      mm.round++;
      if (mm.round >= 2) {
        showMpResults("Memory Masters Results! 🧠", "Most pairs found wins", "🧠");
        return;
      }
      mpTimeout(() => { mmBuildBoard(); mmUpdateHUD(); }, 800);
    }
  } else {
    mpTimeout(() => {
      [a.btn, b.btn].forEach(el => { el.textContent = "?"; el.classList.remove("open"); });
      mm.lock = false;
      // Next player's turn
      const next = (mp.currentIdx + 1) % mp.players.length;
      mp.currentIdx = next;
      mmUpdateHUD();
    }, 700);
  }
}

/* ==================================================================
   MP 10 — DICE DASH
   ================================================================== */
let dice = {};
const DICE_ROUNDS = 5;
const DICE_FACES = ["1️⃣","2️⃣","3️⃣","4️⃣","5️⃣","6️⃣"];

$("diceQuit").addEventListener("click", () => { clearMpTimers(); showTab("home"); document.body.classList.remove("in-game"); });

function startMpDice() {
  mp.scores = mp.players.map(() => 0);
  mp.currentIdx = 0;
  dice = { round: 0 };
  showPassScreen(0, () => diceBeginTurn(0));
}

function diceBeginTurn(idx) {
  dice.idx = idx;
  dice.d1 = null; dice.d2 = null; dice.op = null;
  dice.locked = false;
  renderPlayerHud($("dicePlayerHud"), idx);
  showScreen("screen-mp-dice");
  $("diceKicker").textContent = `${mp.players[idx]}'s Turn — Round ${Math.floor(dice.round / mp.players.length) + 1} / ${DICE_ROUNDS}`;
  $("die1").textContent = "🎲";
  $("die2").textContent = "🎲";
  $("diceResult").textContent = "";
  $("diceOp").textContent = "×";
  $("diceAnswerArea").innerHTML = "";
  $("diceFeedback").className = "feedback";

  [$("die1"), $("die2")].forEach((die, di) => {
    die.onclick = () => {
      if (dice.locked) return;
      die.classList.add("rolling");
      mpTimeout(() => {
        const val = randInt(1, 6);
        if (di === 0) dice.d1 = val; else dice.d2 = val;
        die.textContent = DICE_FACES[val - 1];
        die.classList.remove("rolling");
        if (dice.d1 && dice.d2) diceShowProblem();
      }, 400);
    };
  });
}

function diceShowProblem() {
  dice.op = pick(["+", "×"]);
  const sym = dice.op;
  $("diceOp").textContent = sym;
  const answer = sym === "+" ? dice.d1 + dice.d2 : dice.d1 * dice.d2;
  dice.answer = answer;
  $("diceResult").textContent = "= ?";
  $("diceKicker").textContent = `${DICE_FACES[dice.d1-1]} ${sym} ${DICE_FACES[dice.d2-1]} = ?`;

  const opts = shuffle([answer, ...makeDistractors(answer)]);
  const area = $("diceAnswerArea");
  area.innerHTML = "";
  const wrap = document.createElement("div");
  wrap.className = "choices";
  for (const opt of opts) {
    const btn = document.createElement("button");
    btn.className = "choice";
    btn.textContent = opt;
    btn.addEventListener("click", () => {
      if (dice.locked) return;
      dice.locked = true;
      const fb = $("diceFeedback");
      if (opt === answer) {
        mp.scores[dice.idx] += answer;
        btn.classList.add("good");
        $("diceResult").textContent = "= " + answer;
        fb.className = "feedback good show";
        $("diceFbText").textContent = `✓ +${answer} points!`;
      } else {
        btn.classList.add("bad");
        wrap.querySelectorAll(".choice").forEach(b => { if (+b.textContent === answer) b.classList.add("good"); });
        $("diceResult").textContent = "= " + answer;
        fb.className = "feedback bad show";
        $("diceFbText").textContent = `✗ It was ${answer}`;
      }
      dice.round++;
      mpTimeout(() => {
        const next = (dice.idx + 1) % mp.players.length;
        const totalRounds = DICE_ROUNDS * mp.players.length;
        if (dice.round >= totalRounds) {
          showMpResults("Dice Dash Results! 🎲", "Highest total points wins", "🎲");
        } else {
          showPassScreen(next, () => diceBeginTurn(next));
        }
      }, 800);
    });
    wrap.appendChild(btn);
  }
  area.appendChild(wrap);
}

/* ==================================================================
   MP 11 — SURVIVOR MATH
   ================================================================== */
let survivor = {};

$("survivorQuit").addEventListener("click", () => { clearMpTimers(); showTab("home"); document.body.classList.remove("in-game"); });

function startMpSurvivor() {
  mp.scores = mp.players.map(() => 0);
  mp.eliminated = mp.players.map(() => false);
  mp.currentIdx = 0;
  survivor = { round: 0, activeCount: mp.players.length };
  showScreen("screen-mp-survivor");
  survivorUpdatePlayers();
  survivorNext();
}

function survivorUpdatePlayers() {
  $("survivorPlayers").innerHTML = mp.players.map((name, i) => `
    <div class="survivor-chip${mp.eliminated[i] ? " out" : ""}">
      <div class="survivor-chip-dot" style="background:${PLAYER_COLORS[i]}"></div>
      ${name}
    </div>`).join("");
}

function survivorNext() {
  clearMpTimers();
  // Skip eliminated players
  let tries = 0;
  while (mp.eliminated[mp.currentIdx] && tries < mp.players.length) {
    mp.currentIdx = (mp.currentIdx + 1) % mp.players.length;
    tries++;
  }
  const idx = mp.currentIdx;
  survivor.current = genMpProblem(survivor.round);
  survivor.locked = false;
  $("survivorKicker").textContent = `${mp.players[idx]}'s turn — answer or you're out!`;
  $("survivorExpr").innerHTML = exprHTML(survivor.current.parts);
  $("survivorFeedback").className = "feedback";
  survivorUpdatePlayers();

  const opts = shuffle([survivor.current.answer, ...makeDistractors(survivor.current.answer)]);
  const wrap = $("survivorChoices");
  wrap.innerHTML = "";
  for (const opt of opts) {
    const btn = document.createElement("button");
    btn.className = "choice";
    btn.textContent = opt;
    btn.addEventListener("click", () => {
      if (survivor.locked) return;
      survivor.locked = true;
      const fb = $("survivorFeedback");
      if (opt === survivor.current.answer) {
        mp.scores[idx]++;
        btn.classList.add("good");
        fb.className = "feedback good show";
        $("survivorFbText").textContent = `✓ Safe! ${mp.players[idx]} survives.`;
      } else {
        btn.classList.add("bad");
        wrap.querySelectorAll(".choice").forEach(b => { if (+b.textContent === survivor.current.answer) b.classList.add("good"); });
        mp.eliminated[idx] = true;
        survivor.activeCount--;
        fb.className = "feedback bad show";
        $("survivorFbText").textContent = `✗ ${mp.players[idx]} is eliminated!`;
      }
      if (survivor.activeCount <= 1) {
        const winner = mp.eliminated.findIndex(e => !e);
        if (winner >= 0) mp.scores[winner] += 20;
        mpTimeout(() => showMpResults("Survivor Results! 🔥", `${winner >= 0 ? mp.players[winner] : "Nobody"} survived!`, "🔥"), 1000);
        return;
      }
      survivor.round++;
      mp.currentIdx = (idx + 1) % mp.players.length;
      mpTimeout(survivorNext, 900);
    });
    wrap.appendChild(btn);
  }
}

/* ==================================================================
   MP 12 — SPEED QUIZ BATTLE
   ================================================================== */
let sq = {};
const SQ_ROUNDS = 10;
const SQ_ANSWER_TIME = 8;
const SQ_COLORS = ["#7C3AED","#059669","#D97706","#DC2626"];

$("sqQuit").addEventListener("click", () => { clearMpTimers(); showTab("home"); document.body.classList.remove("in-game"); });

function startMpSpeedQuiz() {
  mp.scores = mp.players.map(() => 0);
  sq = { round: 0, buzzedIdx: null, answerTimer: 0, locked: false, current: null };
  showScreen("screen-mp-speedquiz");
  sqBuildBuzzGrid();
  sqNext();
}

function sqBuildBuzzGrid() {
  const grid = $("sqBuzzGrid");
  grid.innerHTML = "";
  mp.players.forEach((name, i) => {
    const btn = document.createElement("button");
    btn.className = "buzz-btn";
    btn.style.background = SQ_COLORS[i];
    btn.style.opacity = "1";
    btn.id = "sqBuzz" + i;
    btn.innerHTML = `<div style="font-size:22px;margin-bottom:4px;">${name[0].toUpperCase()}</div><div>${name}</div><div style="font-size:12px;margin-top:2px;opacity:0.8">Score: <span id="sqBuzzScore${i}">${mp.scores[i]}</span></div>`;
    btn.addEventListener("click", () => sqBuzz(i));
    grid.appendChild(btn);
  });
}

function sqUpdateScores() {
  mp.players.forEach((_, i) => {
    const el = $("sqBuzzScore" + i);
    if (el) el.textContent = mp.scores[i];
  });
  const best = mp.scores.indexOf(Math.max(...mp.scores));
  $("sqLeader").textContent = mp.players[best] + " (" + mp.scores[best] + ")";
}

function sqNext() {
  sq.current = genMpProblem(sq.round);
  sq.locked = false;
  sq.buzzedIdx = null;
  $("sqRound").textContent = `${sq.round + 1}/${SQ_ROUNDS}`;
  $("sqExpr").innerHTML = exprHTML(sq.current.parts);
  $("sqFeedback").className = "feedback";
  $("sqAnswerInput").className = "buzz-answer-input";
  $("sqAnswerInput").value = "";
  $("sqTimer").textContent = "—";
  sqUpdateScores();

  // Re-enable all buzz buttons
  mp.players.forEach((_, i) => {
    const btn = $("sqBuzz" + i);
    if (btn) { btn.disabled = false; btn.classList.remove("buzzed"); }
  });
}

function sqBuzz(playerIdx) {
  if (sq.locked || sq.buzzedIdx !== null) return;
  sq.buzzedIdx = playerIdx;
  sq.answerTimer = SQ_ANSWER_TIME;
  $("sqTimer").textContent = sq.answerTimer;
  $("sqTimer").style.color = "var(--accent)";

  // Disable other buzz buttons
  mp.players.forEach((_, i) => {
    const btn = $("sqBuzz" + i);
    if (btn) { btn.disabled = i !== playerIdx; if (i === playerIdx) btn.classList.add("buzzed"); }
  });

  const input = $("sqAnswerInput");
  input.className = "buzz-answer-input show";
  input.value = "";
  input.focus();
  input.style.borderColor = SQ_COLORS[playerIdx];
  input.style.boxShadow = `0 0 14px ${SQ_COLORS[playerIdx]}33`;

  const tickTimer = mpInterval(() => {
    sq.answerTimer--;
    $("sqTimer").textContent = sq.answerTimer;
    if (sq.answerTimer <= 3) $("sqTimer").style.color = "var(--red)";
    if (sq.answerTimer <= 0) {
      clearInterval(tickTimer);
      sqTimeOut(playerIdx);
    }
  }, 1000);
  sq.tickTimer = tickTimer;
}

$("sqAnswerInput").addEventListener("input", e => {
  if (sq.buzzedIdx === null) return;
  const val = e.target.value.replace(/[^0-9]/g,"");
  e.target.value = val;
  if (!val) return;
  const typed = parseInt(val, 10);
  if (typed === sq.current.answer) {
    clearInterval(sq.tickTimer);
    sq.locked = true;
    mp.scores[sq.buzzedIdx]++;
    const fb = $("sqFeedback");
    fb.className = "feedback good show";
    $("sqFbText").textContent = `✓ ${mp.players[sq.buzzedIdx]} gets the point!`;
    $("sqAnswerInput").className = "buzz-answer-input";
    sq.round++;
    sqUpdateScores();
    if (sq.round >= SQ_ROUNDS) {
      mpTimeout(() => showMpResults("Speed Quiz Results! 🎯", "Fastest fingers win!", "🎯"), 800);
    } else {
      mpTimeout(sqNext, 900);
    }
  } else if (val.length >= String(sq.current.answer).length) {
    clearInterval(sq.tickTimer);
    sqTimeOut(sq.buzzedIdx);
  }
});

function sqTimeOut(playerIdx) {
  sq.locked = false;
  sq.buzzedIdx = null;
  $("sqAnswerInput").className = "buzz-answer-input";
  const fb = $("sqFeedback");
  fb.className = "feedback bad show";
  $("sqFbText").textContent = `✗ ${mp.players[playerIdx]} timed out!`;
  $("sqTimer").textContent = "—";
  $("sqTimer").style.color = "var(--text-soft)";
  mp.players.forEach((_, i) => {
    const btn = $("sqBuzz" + i);
    if (btn) { btn.disabled = false; btn.classList.remove("buzzed"); }
  });
  mpTimeout(() => { fb.className = "feedback"; }, 1500);
}

/* renderHome — overrides earlier definition to add MP section */
function renderHome() {
  $("streakChip").textContent = getDayStreak().cur;
  renderDailyCard($("dailyCardHome"));
  renderModeList();
  renderMpModeList();
  const s = getDayStreak();
  $("pStreak").textContent = s.cur;
  $("pStreakBest").textContent = s.best;
  $("pTotal").textContent = store.get("mfa-total-score", 0).toLocaleString();
  $("pGames").textContent = store.get("mfa-games-played", 0).toLocaleString();
  $("supaBadge").textContent = sb ? "⚡ Supabase" : "⚠ offline";
}

/* ==================================================================
   BOOT
   ================================================================== */
applyTheme(store.get("mfa-theme", "dark"));
renderHome();
maybeShowInstall();
</script>
</body>
</html>
